<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Repository\Repository.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ASP.NET Core types (MVC filters, logging attributes) come from the shared framework this application already runs on, not from an ASP.NET Core 2.2 era package: a package that old drags its own copy of Microsoft.Extensions.Logging.Abstractions into every project that references this one and shadows the current framework types. -->
